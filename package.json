{
  "name": "@geohar/pi-title",
  "version": "0.4.2",
  "description": "Configurable terminal title for the pi coding agent: session, folder, model, git branch, current tool and more.",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "author": "George Harker <george@georgeharker.com>",
  "homepage": "https://github.com/georgeharker/pi-title#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgeharker/pi-title.git"
  },
  "bugs": {
    "url": "https://github.com/georgeharker/pi-title/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "terminal",
    "title",
    "tab-title"
  ],
  "license": "MIT",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "version:patch": "bun run scripts/version.ts patch",
    "version:minor": "bun run scripts/version.ts minor",
    "version:major": "bun run scripts/version.ts major",
    "release:patch": "bun run scripts/release.ts patch",
    "release:minor": "bun run scripts/release.ts minor",
    "release:major": "bun run scripts/release.ts major",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "bun run check && bun test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4",
    "@earendil-works/pi-tui": ">=0.84.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/bun": "^1.3.13",
    "@types/node": "25.6.0",
    "@typescript/native": "npm:typescript@7",
    "typescript": "6.0.3"
  },
  "contributors": [
    "Thinkscape (original pi-status)"
  ],
  "publishConfig": {
    "access": "public"
  }
}
